<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.example</groupId>
		<artifactId>chat-cloud</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>chat-user</artifactId>
	<name>chat-user</name>
	<description>用户服务，端口 8082（MySQL + MyBatis-Plus）</description>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!--
			Bean Validation：让 DTO 上的 @NotBlank / @Size / @Pattern / @Past 生效。
			注意 spring-boot-starter-web 在 Boot 2.3 之后【不再】自带 validation，
			必须显式引这个 starter —— 否则：
			  · 没有实现（Hibernate Validator）时，@Valid 会【静默什么都不做】
			  · DTO 里的 jakarta.validation.constraints.* 甚至可能编译不过
			（chat-auth 里早就引了；chat-user 是加了带校验的 UpdateProfileRequest 才需要。）
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>com.alibaba.cloud</groupId>
			<artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
		</dependency>

		<!--
			Redis：给"用户资料缓存"用。
			注意这里是【普通（阻塞式）】starter，不是 -reactive 那个 ——
			chat-user 是 Servlet 应用（spring-boot-starter-web），
			用同步的 StringRedisTemplate 就行。
			（chat-gateway 是 WebFlux，那边才必须用 -reactive 版本。）

			⚠️ 目前这个依赖还没有被任何代码使用（读缓存和"改资料删缓存"都还没写），
			所以它现在只是"把地基铺好"。Spring Boot 的 Redis 连接是懒加载的，
			没有代码调用就不会去连 —— 也就是说【现在配置写错了也不会报错】。
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!--
			MyBatis-Plus：Spring Boot 4 必须用专门的 spring-boot4-starter
			（Boot 3 是 spring-boot3-starter，Boot 2 是 spring-boot-starter，别引错）
			版本在父 pom 的 dependencyManagement 里统一管理
		-->
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-spring-boot4-starter</artifactId>
		</dependency>

		<!-- MySQL 驱动，版本由 Spring Boot BOM 管理，不用写 -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
			BCrypt 密码加密。只引 spring-security-crypto，而不是整个
			spring-boot-starter-security —— 后者会自动开启登录过滤器，
			导致所有接口都要认证，我们的 token 校验是自己写的，不需要。
		-->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>

		<dependency>
			<groupId>org.example</groupId>
			<artifactId>chat-common</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
